<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TailwindIntegration.Client\TailwindIntegration.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
  </ItemGroup>
  <Target Name="TailwindBuild" BeforeTargets="Build">
    <Exec Command="tailwindcss -i ./Styles/app.tailwind.css -o ./wwwroot/app.tailwind.css --minify" />
  </Target>

</Project>