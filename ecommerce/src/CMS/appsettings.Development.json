{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "WebRouting": {
        "UmbracoApplicationUrl": "http://127.0.0.1:5001"
      },
      "Hosting": {
        "Debug": true
      }
    }
  },
  "uSync": {
    "Settings": {
      "ImportAtStartup": "None",
      "ImportOnFirstBoot": true,
      "ExportOnSave": "All"
    }
  }
}
