@inject NavigationManager NavigationManager
@implements IDisposable

<MudButton Href="@href" Variant="Variant.Text" Class="@ActiveClass">
    @ChildContent
</MudButton>

@code {
    [Parameter, EditorRequired]
    public required string href { get; set; }

    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    private string ActiveClass => IsActive ? "mud-chip-text mud-chip-color-primary font-semibold" : "";

    private bool IsActive {
        get {
            var currentUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var suffixIndex = currentUri.IndexOfAny(new[] { '?', '#' });
            if (suffixIndex >= 0) {
                currentUri = currentUri.Substring(0, suffixIndex);
            }
            return string.Equals(
                currentUri.Trim('/'),
                href.Trim('/'),
                StringComparison.OrdinalIgnoreCase
            );
        }
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}