<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.8.0" GeneratePathProperty="true" />
    <ProjectReference Include="..\Ecommerce.WebApp.Client\Ecommerce.WebApp.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
  </ItemGroup>

  <Target Name="CopyMudBlazorCss" BeforeTargets="TailwindBuild">
    <Copy SourceFiles="$(PkgMudBlazor)\staticwebassets\MudBlazor.min.css"
      DestinationFolder="$(MSBuildProjectDirectory)\Styles\vendor" />
  </Target>
  <Target Name="TailwindBuild" BeforeTargets="Build">
    <Exec Command="tailwindcss -i ./Styles/app.tailwind.css -o ./wwwroot/app.tailwind.css --minify" />
  </Target>
</Project>