<div class="relative" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave">
    <MudButton Style="@ColorStyle(category.Color)">
        @category.Name
    </MudButton>
    @if (category.Children.Length > 0 && isOpen)
    {
        <div class="absolute top-full left-0 right-0  bg-white shadow-md py-4">
            @foreach (var subCategory in category.Children)
            {
                <NavLink Class="w-full text-left hover:font-semibold py-2 px-2 block" href="#" style="@ColorStyle(subCategory.Color)">
                    @subCategory.Name
                </NavLink>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required Category category { get; set; }

    [Parameter]
    public bool isActive { get; set; } = false;

    [Parameter]
    public bool isNavigationHover { get; set; } = false;

    private bool isOpen = false;

    // Inline style rather than a Tailwind class: the value comes from the CMS at runtime and would be purged at build time.
    private static string? ColorStyle(string? color) =>
        string.IsNullOrWhiteSpace(color) ? null : $"color: {color};";

    private void HandleMouseEnter()
    {
        if (this.category.Children.Length > 0)
        {
            this.isOpen = true;
        }
    }

    private void HandleMouseLeave()
    {
        this.isOpen = false;
    }
}